# ==============================================================================
# Telegram Configuration
# Get API_ID and API_HASH from: https://my.telegram.org
# Get BOT_TOKEN from BotFather: https://t.me/BotFather
# ==============================================================================
BOT_NAME=Torrent Hunt
BOT_TOKEN=
API_ID=
API_HASH=
BOT_ADMINS=

# Directory for session file and SQLite DB (defaults to ./data in Docker)
WORKDIR=/app/data

# Database connection string (defaults to SQLite inside workdir)
DATABASE_URL=sqlite:///torrenthunt.db

# ==============================================================================
# Torrent Search Provider ("jackett" or "prowlarr")
# ==============================================================================
TORRENT_PROVIDER=jackett

# Jackett Settings (if TORRENT_PROVIDER=jackett)
JACKETT_URL=http://localhost:9117
JACKETT_API_KEY=
JACKETT_INDEXER=all
JACKETT_TIMEOUT=40

# Prowlarr Settings (if TORRENT_PROVIDER=prowlarr)
PROWLARR_URL=http://localhost:9696
PROWLARR_API_KEY=
PROWLARR_INDEXER=all
PROWLARR_TIMEOUT=40

# Optional tag-based filtering in Jackett/Prowlarr (leave empty to search all)
MESSAGE_SEARCH_TAG=
INLINE_SEARCH_TAG=

# ==============================================================================
# Cache & Maintenance
# ==============================================================================
TORRENT_CACHE_DAYS=90
CLEANUP_INTERVAL_MINUTES=60

# Optional Sentry error tracking
SENTRY_DSN=
ENVIRONMENT=production
